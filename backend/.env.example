# Copy this file to .env and replace local-only placeholder values.
# Do not commit .env or generated signing keys.

POSTGRES_DB=french_learning
POSTGRES_PORT=5432
DB_URL=jdbc:postgresql://localhost:5432/french_learning
DB_USERNAME=french_app
DB_PASSWORD=replace-with-a-local-password

JWT_PRIVATE_KEY_PATH=.local/keys/jwt-private.pem
JWT_PUBLIC_KEY_PATH=.local/keys/jwt-public.pem
JWT_ISSUER=http://localhost:8080
JWT_AUDIENCE=french-learning-api
